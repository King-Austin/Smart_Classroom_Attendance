{
  "expo": {
    "name": "Smart Campus Presence",
    "slug": "smart-campus-presence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "smartcampuspresence",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartattendance.app.beta",
      "infoPlist": {
        "NSCameraUsageDescription": "Required for face verification during attendance.",
        "NSLocationWhenInUseUsageDescription": "Required to verify your location for class attendance.",
        "NSBluetoothAlwaysUsageDescription": "Required to detect classroom BLE beacons for attendance.",
        "NSBluetoothPeripheralUsageDescription": "Required to broadcast BLE session tokens as a lecturer."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E12"
      },
      "package": "com.smartattendance.app.beta",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
